// https://godotshaders.com/shader/discrete-ocean/

uniform highp vec4 bottom_color;
uniform highp vec4 top_color;

uniform highp float wave_amp;
uniform highp float wave_size;
uniform highp float wave_time_mul;

uniform highp int total_phases;

const highp float PI = 3.14159265;

highp float rand(highp float n) {
    return fract(sin(n) * 43758.5453123);
}

highp float noise(highp float p){
	highp float fl = floor(p);
    highp float fc = fract(p);
	return mix(rand(fl), rand(fl + 1.0), fc);
}

highp float fmod(highp float x, highp float y) {
	return x - floor(x / y) * y;
}


highp vec4 lerp(highp vec4 a, highp vec4 b, highp float w) {
	return a + w * (b - a);
}

void fragment() {
	highp float t = float(total_phases);
	highp float effective_wave_amp = min(wave_amp, 0.5 / t);
	highp float d = fmod(UV.y, 1.0 / t);
	highp float i = floor(UV.y * t);
	highp float vi = floor(UV.y * t + t * effective_wave_amp);
	highp float s = effective_wave_amp * sin((UV.x + TIME * max(1.0 / t, noise(vi)) * wave_time_mul * vi / t) * 2.0 * PI * wave_size);

	if (d < s) i--;
	if (d > s + 1.0 / t) i++;
	i = clamp(i, 0.0, t - 1.0);

	COLOR = lerp(top_color, bottom_color, i / (t - 1.0));
}
